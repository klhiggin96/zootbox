package com.bitmick.marshall;

import android.hardware.usb.UsbDevice;
import android.hardware.usb.UsbDeviceConnection;
import android.hardware.usb.UsbManager;
import android.util.Log;

import com.bitmick.marshall.interfaces.lowlevel_i;
import com.hoho.android.usbserial.driver.CdcAcmSerialDriver;
import com.hoho.android.usbserial.driver.UsbSerialDriver;
import com.hoho.android.usbserial.driver.UsbSerialPort;
import com.hoho.android.usbserial.driver.UsbSerialProber;

import java.io.IOException;
import java.util.Arrays;

/**
 * USB Serial Bridge for Marshall SDK.
 * Implements lowlevel_i to provide serial communication to the Nayax VPOS Touch.
 */
public class UsbSerialBridge implements lowlevel_i {
    private static final String TAG = "UsbSerialBridge";
    private static final int READ_BUFFER_SIZE = 512;
    private static final int READ_TIMEOUT_MS = 100;

    private final UsbManager usbManager;
    private final UsbDevice usbDevice;
    
    private UsbSerialPort serialPort;
    private UsbDeviceConnection connection;
    private link_events_t linkEvents;
    private Thread readThread;
    private volatile boolean running = false;

    public UsbSerialBridge(UsbManager usbManager, UsbDevice usbDevice) {
        this.usbManager = usbManager;
        this.usbDevice = usbDevice;
    }

    @Override
    public void init(Object port, Object baudRate) {
        try {
            Log.d(TAG, "Initializing USB serial bridge");
            
            // Get the serial driver
            UsbSerialDriver driver = UsbSerialProber.getDefaultProber().probeDevice(usbDevice);
            if (driver == null) {
                Log.e(TAG, "No USB serial driver found for device");
                return;
            }

            if (!(driver instanceof CdcAcmSerialDriver)) {
                Log.e(TAG, "Device is not CDC-ACM compatible");
                return;
            }

            serialPort = driver.getPorts().get(0);
            connection = usbManager.openDevice(usbDevice);
            
            if (connection == null) {
                Log.e(TAG, "Failed to open USB device connection");
                return;
            }

            serialPort.open(connection);
            
            int baud = (baudRate instanceof Integer) ? (Integer) baudRate : 115200;
            serialPort.setParameters(
                baud,
                8,
                UsbSerialPort.STOPBITS_1,
                UsbSerialPort.PARITY_NONE
            );

            // Enable control lines
            serialPort.setDTR(true);
            serialPort.setRTS(true);

            Log.i(TAG, "USB serial bridge initialized at " + baud + " bps");
        } catch (Exception e) {
            Log.e(TAG, "Failed to initialize USB serial bridge", e);
        }
    }

    @Override
    public void register_link_events(link_events_t events) {
        this.linkEvents = events;
    }

    @Override
    public void start() {
        if (serialPort == null) {
            Log.e(TAG, "Cannot start - serial port not initialized");
            return;
        }

        running = true;
        readThread = new Thread(this::readLoop, "UsbSerialBridge-Read");
        readThread.start();
        Log.i(TAG, "USB serial bridge started");
    }

    @Override
    public void stop() {
        running = false;
        
        if (readThread != null) {
            readThread.interrupt();
            try {
                readThread.join(1000);
            } catch (InterruptedException e) {
                // Ignore
            }
            readThread = null;
        }

        try {
            if (serialPort != null) {
                serialPort.close();
                serialPort = null;
            }
            if (connection != null) {
                connection.close();
                connection = null;
            }
        } catch (IOException e) {
            Log.e(TAG, "Error closing serial port", e);
        }

        Log.i(TAG, "USB serial bridge stopped");
    }

    @Override
    public void reset() {
        // Reset the serial port by toggling DTR/RTS
        try {
            if (serialPort != null) {
                serialPort.setDTR(false);
                serialPort.setRTS(false);
                Thread.sleep(100);
                serialPort.setDTR(true);
                serialPort.setRTS(true);
            }
        } catch (Exception e) {
            Log.e(TAG, "Error resetting serial port", e);
        }
    }

    @Override
    public boolean transmit(byte[] data, int length) {
        if (serialPort == null) {
            Log.e(TAG, "Cannot transmit - serial port not open");
            return false;
        }

        try {
            byte[] toSend = Arrays.copyOf(data, length);
            serialPort.write(toSend, 1000);
            
            // Always log for debugging
            {
                StringBuilder sb = new StringBuilder("TX: ");
                for (int i = 0; i < length; i++) {
                    sb.append(String.format("%02X ", data[i]));
                }
                Log.d(TAG, sb.toString());
            }
            
            return true;
        } catch (IOException e) {
            Log.e(TAG, "Failed to transmit", e);
            return false;
        }
    }

    @Override
    public void onLinkTimerTick(long timestamp) {
        // No action needed - read loop handles everything
    }

    private void readLoop() {
        byte[] buffer = new byte[READ_BUFFER_SIZE];

        while (running && serialPort != null) {
            try {
                int bytesRead = serialPort.read(buffer, READ_TIMEOUT_MS);
                
                if (bytesRead > 0 && linkEvents != null) {
                    // Always log for debugging
            {
                        StringBuilder sb = new StringBuilder("RX: ");
                        for (int i = 0; i < bytesRead; i++) {
                            sb.append(String.format("%02X ", buffer[i]));
                        }
                        Log.d(TAG, sb.toString());
                    }
                    
                    linkEvents.onReceive(buffer, 0, bytesRead);
                }
            } catch (IOException e) {
                if (running) {
                    Log.w(TAG, "Read error: " + e.getMessage());
                    try {
                        Thread.sleep(100);
                    } catch (InterruptedException ie) {
                        break;
                    }
                }
            }
        }

        Log.d(TAG, "Read loop terminated");
    }

    public boolean isConnected() {
        return serialPort != null && connection != null;
    }
}
