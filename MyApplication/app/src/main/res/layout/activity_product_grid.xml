<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- ================= BACKGROUND ================= -->
    <!-- Video Background Layer 1 -->
    <com.example.myapplication.FullScreenVideoView
        android:id="@+id/bg_video_view_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        android:alpha="1.0"
        android:visibility="gone"
        android:layerType="hardware" />

    <!-- Video Background Layer 2 -->
    <com.example.myapplication.FullScreenVideoView
        android:id="@+id/bg_video_view_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp"
        android:alpha="0.0"
        android:visibility="gone"
        android:layerType="hardware" />
    
    
    <!-- ================= CONTENT ================= -->
    <TextView
        android:id="@+id/title_zootbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ZOOTBOX"
        android:fontFamily="@font/archivo_black"
        android:textColor="@color/black"
        android:textSize="90sp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:layout_marginTop="20dp"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Grid (No Container) - Full Screen -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/product_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="160dp"
        android:paddingBottom="24dp"
        android:overScrollMode="never"
        android:background="@android:color/transparent" />

    <!-- Back Button - positioned at left edge, on top of everything -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:padding="14dp"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/bg_back_button_glow"
        android:elevation="100dp"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>