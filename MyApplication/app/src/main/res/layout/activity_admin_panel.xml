<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- PIN Entry Layout -->
    <LinearLayout
        android:id="@+id/pin_entry_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Access"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter 4-digit PIN"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <!-- PIN Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/pin_dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />
        </LinearLayout>

        <!-- Error Message -->
        <TextView
            android:id="@+id/pin_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wrong PIN"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Keypad -->
        <GridLayout
            android:id="@+id/pin_keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_gravity="center">
            <!-- Number buttons will be added programmatically -->
        </GridLayout>

    </LinearLayout>

    <!-- Inventory Overview Layout -->
    <LinearLayout
        android:id="@+id/inventory_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventory Management"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/total_inventory_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Stock: 0 / 100"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/stats_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empty: 0 | Low: 0 | Normal: 0 | Full: 0"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>

        <!-- Coils RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coils_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <Button
                android:id="@+id/fill_all_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Fill All to 10"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/manual_entry_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Manual Entry"
                    android:textSize="14sp"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/view_stats_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="View Stats"
                    android:textSize="14sp"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/exit_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Exit"
                android:textSize="14sp"
                android:backgroundTint="#6B7280"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
