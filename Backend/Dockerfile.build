FROM golang:1.23-alpine

# Install build tools for ARM64 static compilation
RUN apk add --no-cache \
    gcc \
    g++ \
    musl-dev \
    git

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build static binary for ARM64 with CGO (for SQLite)
ENV CGO_ENABLED=1
ENV GOOS=linux
ENV GOARCH=arm64
ENV CC=gcc

# Build with static linking
RUN go build \
    -ldflags="-w -s -linkmode external -extldflags '-static'" \
    -tags 'osusergo netgo sqlite_omit_load_extension' \
    -o zootbox-backend-arm64 \
    ./cmd/server

CMD ["cp", "zootbox-backend-arm64", "/output/"]
